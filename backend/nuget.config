<?xml version="1.0" encoding="utf-8"?>
<!-- پکیج‌های AhmadBase.* از فولدر لوکال Nuget/ می‌آیند تا build داخل کانتینر
     (که به Nexus روی localhost دسترسی ندارد) هم کار کند.
     اگر Nexus بالا داری و می‌خواهی از آن بکشی، منبعش را اینجا اضافه کن و
     رمز را از متغیر محیطی بده — هرگز داخل این فایل ننویس. -->
<configuration>
  <config>
    <add key="ignoreFailedSources" value="true" />
  </config>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <add key="LocalNuget" value="Nuget" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="LocalNuget">
      <package pattern="AhmadBase.*" />
      <package pattern="Ahmad.Base.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
