<?xml version="1.0" encoding="utf-8"?>
<!--
  سرور روی HTTPS با گواهی معتبر Let's Encrypt است، پس هیچ استثنایی لازم نیست.
  این فایل عمداً می‌ماند تا صریح باشد که HTTP ساده بسته است — نه اینکه
  فقط پیش‌فرضِ اندروید رویش اثر کند.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
</network-security-config>
